# ── MARK LV — what never belongs in the repository ──────────────────────────
# Everything listed here is created by the app on first run. A fresh clone with
# none of it present boots straight to the setup screen, which is the intended
# first experience — so nothing here needs to be committed, and some of it must
# never be.

# ── Secrets. Committing any of these publishes them. ──────────────────────────
# Provider keys, preferences and per-plugin settings.
config/*.json
# Local 256-bit credential-vault master key.
config/.vault.key
# Dashboard TLS private key and certificate.
config/certs/
config/*.pem
config/*.key
config/*.p12
config/*.pfx
config/*.crt
config/*.cer
# A linked WhatsApp session grants account access, not merely a key.
config/whatsapp_web/
# Google OAuth tokens and client secrets (Gmail / Calendar plugins).
**/token*.json
**/client_secret*.json
*credentials*.json
.env
.env.*

# ── Personal data the assistant accumulates about you ─────────────────────────
# JSON/YAML files in memory are runtime state (identity, chats, account metadata,
# routines, pairings, permissions, indexes, etc.), never distributable defaults.
memory/*.json
memory/*.jsonl
memory/*.yaml
memory/*.yml
memory/*.tmp
memory/*.invalid
memory/*.quarantine/
memory/soul.quarantine/
memory/soul.migrations/
memory/*.db
memory/*.db-*
memory/*.sqlite*
memory/calendar_monitor_enabled
memory/knowledge_files/
memory/custom_skills/
memory/lecture_capture/*
!memory/lecture_capture/.gitkeep

# Generated model/media outputs can contain names, faces, voices, documents, or
# prompt content. Source assets belong outside memory/ and must be added explicitly.
memory/*.png
memory/*.jpg
memory/*.jpeg
memory/*.webp
memory/*.gif
memory/*.bmp
memory/*.svg
memory/*.wav
memory/*.mp3
memory/*.m4a
memory/*.aac
memory/*.ogg
memory/*.opus
memory/*.flac
memory/*.mp4
memory/*.mov
memory/*.mkv
memory/*.webm
memory/*.avi
memory/*.pdf
memory/*.doc
memory/*.docx
memory/*.ppt
memory/*.pptx
memory/*.xls
memory/*.xlsx
memory/*.csv
memory/*.txt

# ── Python build noise ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Editors and operating systems ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── Node / frontend build artifacts (e.g. apex_ui) ───────────────────────────
node_modules/
.next/

# ── Runtime output ────────────────────────────────────────────────────────────
*.log
logs/
downloads/
screenshots/
recordings/
outputs/
tmp/
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Browser automation profiles hold cookies and authenticated sessions.
.jarvis_profiles/
**/user-data/
**/user_data/
**/browser-profile/
**/browser_profiles/
**/Cookies
**/Cookies-journal
**/Login Data
**/Local State

# Source excerpts and acquired subject knowledge are private runtime data.
memory/learning/

# Preserve privacy for existing generated video outputs and intermediate plans.
memory/generated_videos/

*.tsbuildinfo
